// ---------- Vault & Markdown Documents ----------

async function renderVault() {
  try {
    const res = await fetch('/api/vault');
    const files = await res.json();
    const list = document.getElementById('vault-list');
    list.innerHTML = '';

    files.forEach(file => {
      const div = document.createElement('div');
      div.className = 'vault-item';
      div.textContent = `📄 ${file}`;
      div.onclick = () => loadNote(file);
      list.appendChild(div);
    });
  } catch (err) {
    console.error('Failed reading vault:', err);
  }
}

async function loadNote(fileName) {
  playSound('action');
  try {
    const res = await fetch(`/api/vault/${encodeURIComponent(fileName)}`);
    const data = await res.json();

    const contentDiv = document.getElementById('overlay-body');
    contentDiv.innerHTML = '';

    const h2 = document.createElement('h2');
    h2.textContent = data.name;
    contentDiv.appendChild(h2);

    const bodyDiv = document.createElement('div');
    bodyDiv.className = 'md-body';

    // Parse [[backlinks]] and #tags safely using DOM elements
    const parts = data.text.split(/(\[\[.*?\]\]|#\w+)/g);
    parts.forEach(part => {
      if (part.startsWith('[[') && part.endsWith(']]')) {
        const linkTarget = part.slice(2, -2);
        const a = document.createElement('span');
        a.textContent = linkTarget;
        a.style.color = 'var(--accent)';
        a.style.cursor = 'pointer';
        a.style.textDecoration = 'underline';
        a.onclick = () => loadNote(`${linkTarget}.md`);
        bodyDiv.appendChild(a);
      } else if (part.startsWith('#') && part.length > 1) {
        const tag = document.createElement('span');
        tag.textContent = part;
        tag.style.color = 'var(--accent-purple)';
        tag.style.fontWeight = 'bold';
        bodyDiv.appendChild(tag);
      } else {
        bodyDiv.appendChild(document.createTextNode(part));
      }
    });

    contentDiv.appendChild(bodyDiv);

    // Render Backlinks
    if (data.backlinks && data.backlinks.length > 0) {
      const blBox = document.createElement('div');
      blBox.className = 'backlinks-box';
      const blTitle = document.createElement('h4');
      blTitle.textContent = 'CONNECTED BACKLINKS';
      blBox.appendChild(blTitle);

      data.backlinks.forEach(bl => {
        const tag = document.createElement('div');
        tag.className = 'vault-item';
        tag.textContent = `← ${bl}`;
        tag.onclick = () => loadNote(bl);
        blBox.appendChild(tag);
      });
      contentDiv.appendChild(blBox);
    }

    document.getElementById('note-overlay').style.display = 'flex';
  } catch (err) {
    console.error('Failed to load note:', err);
  }
}

function closeNoteOverlay() {
  document.getElementById('note-overlay').style.display = 'none';
}

async function saveCurrentNote() {
  const title = document.getElementById('note-title').value.trim();
  const text = document.getElementById('note-text').value.trim();
  if (!title || !text) return alert('Document title and body required.');

  try {
    const res = await fetch('/api/save-note', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title, text })
    });
    const data = await res.json();
    if (data.ok) {
      document.getElementById('note-title').value = '';
      document.getElementById('note-text').value = '';
      playSound('action');
      renderVault();
    }
  } catch (err) {
    console.error('Failed saving note:', err);
  }
}

// ---------- 3D Brain Topology (Three.js) ----------

let brainScene, brainCamera, brainRenderer, brainGroup;
let brainNodes = [];
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();

async function initBrain3D() {
  const container = document.getElementById('brain-3d-container');
  if (!container || brainScene) return;

  brainScene = new THREE.Scene();
  brainCamera = new THREE.PerspectiveCamera(65, container.clientWidth / container.clientHeight, 0.1, 1000);
  brainCamera.position.z = 18;

  brainRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  brainRenderer.setSize(container.clientWidth, container.clientHeight);
  brainRenderer.setPixelRatio(window.devicePixelRatio);
  container.appendChild(brainRenderer.domElement);

  brainGroup = new THREE.Group();
  brainScene.add(brainGroup);

  // Ambient particles
  const particleGeo = new THREE.BufferGeometry();
  const particleCount = 200;
  const posArray = new Float32Array(particleCount * 3);
  for (let i = 0; i < particleCount * 3; i++) {
    posArray[i] = (Math.random() - 0.5) * 30;
  }
  particleGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
  const particleMat = new THREE.PointsMaterial({ size: 0.04, color: 0x38bdf8, transparent: true, opacity: 0.4 });
  const particles = new THREE.Points(particleGeo, particleMat);
  brainScene.add(particles);

  try {
    const res = await fetch('/api/file-tree');
    const tree = await res.json();

    const flat = [];
    const traverse = (node, depth = 0, pId = null) => {
      const id = flat.length;
      flat.push({ ...node, id, depth, pId });
      if (node.children) node.children.forEach(c => traverse(c, depth + 1, id));
    };
    traverse(tree);

    flat.forEach((item, idx) => {
      const isFolder = item.type === 'folder';
      const geometry = new THREE.SphereGeometry(isFolder ? 0.35 : 0.2, 16, 16);
      const material = new THREE.MeshBasicMaterial({
        color: isFolder ? 0x00f2fe : 0x8b5cf6,
        wireframe: isFolder
      });
      const mesh = new THREE.Mesh(geometry, material);

      const phi = Math.acos(-1 + (2 * idx) / flat.length);
      const theta = Math.sqrt(flat.length * Math.PI) * phi;
      const radius = 6 + item.depth * 1.5;

      mesh.position.set(
        radius * Math.cos(theta) * Math.sin(phi),
        radius * Math.sin(theta) * Math.sin(phi),
        radius * Math.cos(phi)
      );

      mesh.userData = { name: item.name, path: item.path, type: item.type };
      brainGroup.add(mesh);
      brainNodes.push(mesh);
    });
  } catch (err) {
    console.warn('Could not build 3D nodes:', err);
  }

  // Mouse move raycasting
  const tooltip = document.getElementById('brain-tooltip');
  container.addEventListener('mousemove', (e) => {
    const rect = container.getBoundingClientRect();
    mouse.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
    mouse.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;
  });

  container.addEventListener('click', () => {
    raycaster.setFromCamera(mouse, brainCamera);
    const hits = raycaster.intersectObjects(brainNodes);
    if (hits.length > 0) {
      const hit = hits[0].object;
      if (hit.userData.name.endsWith('.md')) {
        loadNote(hit.userData.name);
      }
    }
  });

  function animate() {
    requestAnimationFrame(animate);
    brainGroup.rotation.y += 0.0015;
    brainGroup.rotation.x += 0.0008;

    raycaster.setFromCamera(mouse, brainCamera);
    const intersects = raycaster.intersectObjects(brainNodes);

    brainNodes.forEach(n => n.scale.set(1, 1, 1));

    if (intersects.length > 0) {
      const hit = intersects[0].object;
      hit.scale.set(1.6, 1.6, 1.6);
      tooltip.style.display = 'block';
      tooltip.textContent = hit.userData.name;
    } else {
      tooltip.style.display = 'none';
    }

    brainRenderer.render(brainScene, brainCamera);
  }
  animate();
}

// ---------- Claude Terminal / Chat ----------

async function sendChat() {
  const input = document.getElementById('chat-input');
  const windowEl = document.getElementById('chat-window');
  const prompt = input.value.trim();
  if (!prompt) return;

  playSound('terminal');

  // User Message
  const userDiv = document.createElement('div');
  userDiv.className = 'chat-msg user';
  const uAuthor = document.createElement('span');
  uAuthor.className = 'msg-author';
  uAuthor.textContent = 'YOU';
  const uBody = document.createElement('span');
  uBody.className = 'msg-body';
  uBody.textContent = prompt;
  userDiv.appendChild(uAuthor);
  userDiv.appendChild(uBody);
  windowEl.appendChild(userDiv);

  input.value = '';
  windowEl.scrollTop = windowEl.scrollHeight;

  // Loading state
  const loadDiv = document.createElement('div');
  loadDiv.className = 'chat-msg system';
  const sAuthor = document.createElement('span');
  sAuthor.className = 'msg-author';
  sAuthor.textContent = 'CLAUDE-DAEMON';
  const sBody = document.createElement('span');
  sBody.className = 'msg-body';
  sBody.textContent = 'Synthesizing response...';
  loadDiv.appendChild(sAuthor);
  loadDiv.appendChild(sBody);
  windowEl.appendChild(loadDiv);

  try {
    const res = await fetch('/api/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt })
    });
    const data = await res.json();
    playSound('action');

    loadDiv.remove();

    const osDiv = document.createElement('div');
    osDiv.className = 'chat-msg os';
    const oAuthor = document.createElement('span');
    oAuthor.className = 'msg-author';
    oAuthor.textContent = 'SPIKE//OS';
    const oBody = document.createElement('span');
    oBody.className = 'msg-body';
    oBody.textContent = data.answer || 'Execution finished without output.';
    osDiv.appendChild(oAuthor);
    osDiv.appendChild(oBody);
    windowEl.appendChild(osDiv);
  } catch (err) {
    loadDiv.remove();
    const errDiv = document.createElement('div');
    errDiv.className = 'chat-msg system';
    errDiv.innerHTML = '<span class="msg-author" style="color:var(--accent-red)">ERROR</span><span class="msg-body">Failed to communicate with Claude runner. Check server logs.</span>';
    windowEl.appendChild(errDiv);
  }
  windowEl.scrollTop = windowEl.scrollHeight;
}

function handleChatKey(e) {
  if (e.key === 'Enter') sendChat();
}

function clearChat() {
  document.getElementById('chat-window').innerHTML = '';
}

// ---------- Command Palette & Global Search ----------

function openCmdPalette() {
  const overlay = document.getElementById('command-overlay');
  const input = document.getElementById('command-input');
  overlay.style.display = 'flex';
  input.focus();
}

function closeCmdPalette() {
  document.getElementById('command-overlay').style.display = 'none';
  document.getElementById('command-input').value = '';
}

async function doSearch() {
  const query = document.getElementById('global-search').value.trim();
  const resultsDiv = document.getElementById('search-results');

  if (query.length < 2) {
    resultsDiv.style.display = 'none';
    return;
  }

  try {
    const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
    const results = await res.json();

    resultsDiv.innerHTML = '';
    if (results.length > 0) {
      resultsDiv.style.display = 'block';
      results.forEach(item => {
        const row = document.createElement('div');
        row.className = 'vault-item';
        row.textContent = `🔍 ${item.name}`;
        row.onclick = () => {
          showTab('brain');
          loadNote(item.name);
          resultsDiv.style.display = 'none';
        };
        resultsDiv.appendChild(row);
      });
    } else {
      resultsDiv.style.display = 'none';
    }
  } catch (err) {
    console.error('Search error:', err);
  }
}

// ---------- OS Initialization ----------

function initOS() {
  showTab('sprints');

  // Clock HUD
  setInterval(() => {
    const d = new Date();
    document.getElementById('clock-display').textContent = d.toTimeString().split(' ')[0];
  }, 1000);

  // Global Keyboard Shortcuts
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const overlay = document.getElementById('command-overlay');
      if (overlay.style.display === 'none') openCmdPalette();
      else closeCmdPalette();
    }
    if (e.key === 'Escape') {
      closeCmdPalette();
    }
  });
}

let currentTab = 'sprints';
let audioEnabled = true;
let audioCtx = null;

// ---------- Audio Synthesis Engine (Native Web Audio) ----------

function playSound(type) {
  if (!audioEnabled) return;
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);

    const now = audioCtx.currentTime;

    if (type === 'click') {
      osc.frequency.setValueAtTime(800, now);
      osc.frequency.exponentialRampToValueAtTime(400, now + 0.04);
      gain.gain.setValueAtTime(0.04, now);
      gain.gain.linearRampToValueAtTime(0.01, now + 0.04);
      osc.start(now);
      osc.stop(now + 0.04);
    } else if (type === 'action') {
      osc.frequency.setValueAtTime(440, now);
      osc.frequency.exponentialRampToValueAtTime(880, now + 0.08);
      gain.gain.setValueAtTime(0.05, now);
      gain.gain.linearRampToValueAtTime(0.01, now + 0.08);
      osc.start(now);
      osc.stop(now + 0.08);
    } else if (type === 'terminal') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(320, now);
      gain.gain.setValueAtTime(0.03, now);
      gain.gain.linearRampToValueAtTime(0.001, now + 0.05);
      osc.start(now);
      osc.stop(now + 0.05);
    }
  } catch (e) {
    // Audio context may require explicit user gesture
  }
}

function toggleAudio() {
  audioEnabled = !audioEnabled;
  document.getElementById('sound-btn').textContent = audioEnabled ? '🔊 SFX: ON' : '🔇 SFX: OFF';
}

// ---------- Tab Navigation ----------

function showTab(tabId) {
  playSound('click');
  currentTab = tabId;

  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

  const activeSection = document.getElementById(tabId);
  const activeBtn = document.getElementById('btn-' + tabId);

  if (activeSection) activeSection.classList.add('active');
  if (activeBtn) activeBtn.classList.add('active');

  const titleMap = {
    sprints: 'WORKSPACE // SPRINTS & ROADMAP',
    agents: 'FLEET // AUTONOMOUS WORKERS',
    brain: 'NEURAL VAULT // KNOWLEDGE TOPOLOGY',
    ideas: 'IDEATION // INCUBATOR STREAM',
    links: 'REPOSITORIES // ESSENTIAL BOOKMARKS',
    chat: 'TERMINAL // CLAUDE-CODE INTERFACE'
  };
  document.getElementById('current-view-title').textContent = titleMap[tabId] || 'WORKSPACE';

  if (tabId === 'sprints') renderSprints();
  if (tabId === 'agents') renderAgents();
  if (tabId === 'links') renderLinks();
  if (tabId === 'ideas') renderIdeas();
  if (tabId === 'brain') {
    renderVault();
    initBrain3D();
  }
}

// ---------- Sprint Board (Interactive Kanban) ----------

async function renderSprints() {
  try {
    const res = await fetch('/api/data/sprints');
    const tasks = await res.json();

    document.getElementById('count-sprints').textContent = tasks.length;

    const cols = {
      backlog: document.getElementById('col-backlog'),
      todo: document.getElementById('col-todo'),
      doing: document.getElementById('col-doing'),
      done: document.getElementById('col-done')
    };

    Object.values(cols).forEach(col => { if (col) col.innerHTML = ''; });

    const counts = { backlog: 0, todo: 0, doing: 0, done: 0 };

    tasks.forEach(task => {
      const status = task.status || 'todo';
      if (counts[status] !== undefined) counts[status]++;

      const card = document.createElement('div');
      card.className = 'task-card';

      const meta = document.createElement('div');
      meta.className = 'task-meta';

      const tag = document.createElement('span');
      tag.className = 'project-tag';
      tag.textContent = task.project || 'spike-os';

      const idSpan = document.createElement('span');
      idSpan.className = 'task-id';
      idSpan.textContent = `#${task.id}`;

      meta.appendChild(tag);
      meta.appendChild(idSpan);

      const title = document.createElement('div');
      title.className = 'task-title';
      title.textContent = task.title;

      const controls = document.createElement('div');
      controls.className = 'task-controls';

      // Move buttons depending on current status
      const nextStatusMap = {
        backlog: ['todo'],
        todo: ['doing'],
        doing: ['done'],
        done: ['todo']
      };

      (nextStatusMap[status] || []).forEach(next => {
        const moveBtn = document.createElement('button');
        moveBtn.className = 'btn-move';
        moveBtn.textContent = `→ ${next}`;
        moveBtn.onclick = (e) => {
          e.stopPropagation();
          updateTaskStatus(task.id, next);
        };
        controls.appendChild(moveBtn);
      });

      card.appendChild(meta);
      card.appendChild(title);
      card.appendChild(controls);

      if (cols[status]) cols[status].appendChild(card);
    });

    // Update column counters
    document.getElementById('badge-backlog').textContent = counts.backlog;
    document.getElementById('badge-todo').textContent = counts.todo;
    document.getElementById('badge-doing').textContent = counts.doing;
    document.getElementById('badge-done').textContent = counts.done;
  } catch (err) {
    console.error('Failed to load sprints:', err);
  }
}

async function updateTaskStatus(taskId, newStatus) {
  playSound('action');
  try {
    const res = await fetch('/api/data/sprints');
    const tasks = await res.json();
    const task = tasks.find(t => t.id === taskId);
    if (task) {
      task.status = newStatus;
      await fetch('/api/data/sprints', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(tasks)
      });
      renderSprints();
    }
  } catch (err) {
    console.error('Failed updating task:', err);
  }
}

async function showNewTaskModal() {
  const title = prompt('Enter new task description:');
  if (!title) return;
  const project = prompt('Enter project name (default: spike-os):') || 'spike-os';

  try {
    const res = await fetch('/api/data/sprints');
    const tasks = await res.json();
    const nextId = tasks.reduce((max, t) => Math.max(max, t.id || 0), 0) + 1;

    tasks.push({ id: nextId, title, status: 'todo', project });

    await fetch('/api/data/sprints', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(tasks)
    });
    playSound('action');
    renderSprints();
  } catch (err) {
    console.error('Failed to save task:', err);
  }
}


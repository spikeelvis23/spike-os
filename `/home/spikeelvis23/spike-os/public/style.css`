/* ==========================================================================
   SPIKE-OS: Cyberpunk / Linear Dark Minimalist Theme
   ========================================================================== */

:root {
  --bg-deep: #080a0f;
  --bg-surface: #0e131f;
  --bg-card: rgba(18, 24, 38, 0.7);
  --bg-card-hover: rgba(28, 38, 58, 0.85);
  --bg-elevated: #1a2234;

  --accent: #00f2fe;
  --accent-glow: rgba(0, 242, 254, 0.25);
  --accent-green: #10b981;
  --accent-purple: #8b5cf6;
  --accent-orange: #f59e0b;
  --accent-red: #ef4444;

  --border: rgba(255, 255, 255, 0.08);
  --border-focus: rgba(0, 242, 254, 0.5);

  --text-main: #f1f5f9;
  --text-muted: #8492a6;
  --text-dim: #475569;

  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'Fira Code', monospace;

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-deep);
  color: var(--text-main);
  font-family: var(--font-sans);
  height: 100vh;
  overflow: hidden;
  user-select: none;
}

/* Background Atmosphere */
.ambient-glow {
  position: fixed;
  inset: 0;
  background:
    radial-gradient(circle at 15% 15%, rgba(0, 242, 254, 0.05) 0%, transparent 40%),
    radial-gradient(circle at 85% 85%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
  pointer-events: none;
  z-index: 0;
}

/* App Layout Grid */
.app-shell {
  display: flex;
  height: 100vh;
  position: relative;
  z-index: 1;
}

/* Sidebar */
.sidebar {
  width: 260px;
  background: var(--bg-surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 1.25rem;
  gap: 1.25rem;
  z-index: 10;
}

.brand {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.brand-badge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.pulse-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 10px var(--accent);
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.brand-title {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: var(--accent);
}

.brand-version {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  color: var(--text-dim);
  letter-spacing: 1px;
}

/* Sidebar Search */
.search-box {
  position: relative;
}

.search-box input {
  width: 100%;
  padding: 0.6rem 0.75rem 0.6rem 2.25rem;
  background: var(--bg-deep);
  border: 1px solid var(--border);
  color: var(--text-main);
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-family: var(--font-sans);
  outline: none;
  transition: all 0.2s;
}

.search-box input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 12px var(--accent-glow);
}

.search-icon {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  width: 14px;
  height: 14px;
  color: var(--text-dim);
}

.search-results-dropdown {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  max-height: 250px;
  overflow-y: auto;
  display: none;
  z-index: 50;
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.6);
}

/* Nav Menu */
.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex: 1;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  border-radius: var(--radius-md);
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s;
  text-align: left;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-main);
}

.nav-item.active {
  background: rgba(0, 242, 254, 0.1);
  border-color: rgba(0, 242, 254, 0.3);
  color: var(--accent);
}

.nav-count {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-dim);
  background: rgba(255, 255, 255, 0.05);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
}

.nav-item.active .nav-count {
  color: var(--accent);
  background: rgba(0, 242, 254, 0.15);
}

/* Sidebar Footer */
.sidebar-footer {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}

.system-telemetry {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-dim);
}

.telemetry-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meter-bar {
  width: 90px;
  height: 5px;
  background: var(--bg-deep);
  border-radius: 4px;
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  background: var(--accent);
}

.sound-toggle-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 0.4rem;
  border-radius: var(--radius-sm);
  cursor: pointer;
}

.sound-toggle-btn:hover {
  border-color: var(--accent);
  color: var(--text-main);
}

/* Topbar */
.main-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.topbar {
  height: 52px;
  background: rgba(14, 19, 31, 0.7);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  font-family: var(--font-mono);
}

.hud-breadcrumb {
  font-size: 0.8rem;
  letter-spacing: 1.5px;
  color: var(--accent);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.hud-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.kbd-hint {
  cursor: pointer;
  background: rgba(255, 255, 255, 0.04);
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
}

.kbd-hint kbd {
  background: var(--bg-deep);
  padding: 2px 4px;
  border-radius: 3px;
  color: var(--accent);
}

.status-dot {
  width: 6px;
  height: 6px;
  background: var(--accent-green);
  border-radius: 50%;
  box-shadow: 0 0 6px var(--accent-green);
}

/* Main Content Area */
.content-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 1.75rem;
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 1.5rem;
}

.panel-heading {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.5px;
}

.panel-subheading {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 0.2rem;
}

/* Buttons */
.action-btn {
  padding: 0.6rem 1.1rem;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  border: 1px solid transparent;
}

.action-btn.primary {
  background: var(--accent);
  color: var(--bg-deep);
}

.action-btn.primary:hover {
  box-shadow: 0 0 15px var(--accent-glow);
  transform: translateY(-1px);
}

/* Kanban Grid */
.kanban-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
  min-height: calc(100vh - 200px);
}

.kanban-col {
  background: rgba(14, 19, 31, 0.4);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  padding: 1rem;
  gap: 0.75rem;
}

.col-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border);
}

.col-title {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 1px;
  color: var(--text-muted);
  font-weight: 600;
}

.col-badge {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  background: rgba(255, 255, 255, 0.05);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
  color: var(--text-muted);
}

.col-badge.highlight {
  color: var(--accent);
  background: rgba(0, 242, 254, 0.15);
}

.col-cards {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}

/* Kanban Cards */
.task-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  transition: all 0.2s;
  cursor: pointer;
}

.task-card:hover {
  background: var(--bg-card-hover);
  border-color: rgba(255, 255, 255, 0.15);
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
}

.task-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.project-tag {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--accent);
  background: rgba(0, 242, 254, 0.1);
  padding: 2px 6px;
  border-radius: 3px;
  border: 1px solid rgba(0, 242, 254, 0.2);
}

.task-id {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text-dim);
}

.task-title {
  font-size: 0.875rem;
  line-height: 1.4;
  color: var(--text-main);
  font-weight: 500;
}

.task-controls {
  display: flex;
  justify-content: flex-end;
  gap: 0.35rem;
  margin-top: 0.25rem;
}

.btn-move {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
  font-size: 0.65rem;
  padding: 2px 6px;
  border-radius: 3px;
  cursor: pointer;
  font-family: var(--font-mono);
}

.btn-move:hover {
  border-color: var(--accent);
  color: var(--accent);
}

/* Agents Grid */
.agent-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.25rem;
}

.agent-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: relative;
  overflow: hidden;
}

.agent-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: var(--accent);
}

.agent-header {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.agent-avatar {
  font-size: 2rem;
  background: rgba(255, 255, 255, 0.05);
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
}

.agent-info h3 {
  font-size: 1.1rem;
  font-weight: 600;
}

.agent-role {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.agent-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
}

.status-pill {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 2px 8px;
  border-radius: 12px;
  text-transform: uppercase;
}

.status-pill.active {
  background: rgba(16, 185, 129, 0.15);
  color: var(--accent-green);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.agent-action-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-main);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  cursor: pointer;
}

.agent-action-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

/* Brain / Neural Section */
.brain-full-container {
  display: flex;
  height: calc(100vh - 170px);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-deep);
}

.brain-sidebar {
  width: 320px;
  background: var(--bg-surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 1.25rem;
  gap: 1rem;
}

.vault-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vault-header h3 {
  font-size: 0.85rem;
  font-family: var(--font-mono);
  letter-spacing: 1px;
}

.hud-tag {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  color: var(--accent);
}

.vault-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.vault-item {
  padding: 0.6rem 0.75rem;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.vault-item:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--border);
}

.note-editor {
  border-top: 1px solid var(--border);
  padding-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.note-editor h4 {
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--text-muted);
}

.note-editor input, .note-editor textarea {
  width: 100%;
  background: var(--bg-deep);
  border: 1px solid var(--border);
  color: var(--text-main);
  border-radius: var(--radius-md);
  padding: 0.5rem;
  font-size: 0.8rem;
  font-family: var(--font-sans);
  outline: none;
}

.note-editor textarea {
  height: 90px;
  resize: none;
}

.brain-visual {
  flex: 1;
  position: relative;
  background: radial-gradient(circle at center, #0e1626 0%, #05070a 100%);
}

.canvas-controls {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-dim);
  z-index: 5;
  background: rgba(0, 0, 0, 0.6);
  padding: 4px 8px;
  border-radius: 4px;
}

.brain-3d-canvas {
  width: 100%;
  height: 100%;
}

/* Note Overlay Drawer */
.note-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  z-index: 20;
  display: flex;
  justify-content: flex-end;
}

.overlay-content {
  width: 500px;
  height: 100%;
  background: var(--bg-surface);
  border-left: 1px solid var(--border);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  overflow-y: auto;
}

.overlay-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.overlay-type {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--accent);
}

.close-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 1.25rem;
  cursor: pointer;
}

.md-body {
  line-height: 1.7;
  font-size: 0.95rem;
  color: #cbd5e1;
}

.backlinks-box {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}

/* Terminal Chat */
.terminal-container {
  height: calc(100vh - 170px);
  background: #05070b;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
}

.terminal-bar {
  background: var(--bg-surface);
  padding: 0.6rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}

.terminal-dots {
  display: flex;
  gap: 6px;
}

.terminal-dots .dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.dot.red { background: #ff5f56; }
.dot.yellow { background: #ffbd2e; }
.dot.green { background: #27c93f; }

.terminal-title {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
}

.clear-terminal-btn {
  background: transparent;
  border: none;
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  cursor: pointer;
}

.chat-window {
  flex: 1;
  padding: 1.5rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
}

.chat-msg {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.msg-author {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 1px;
}

.chat-msg.user .msg-author { color: var(--accent); }
.chat-msg.system .msg-author { color: var(--accent-purple); }
.chat-msg.os .msg-author { color: var(--accent-green); }

.msg-body {
  color: var(--text-main);
  line-height: 1.6;
  white-space: pre-wrap;
}

.chat-input-row {
  display: flex;
  align-items: center;
  padding: 0.75rem 1rem;
  background: var(--bg-surface);
  border-top: 1px solid var(--border);
  gap: 0.75rem;
}

.cli-arrow {
  color: var(--accent);
  font-family: var(--font-mono);
  font-weight: 700;
}

.chat-input-row input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-main);
  font-family: var(--font-mono);
  font-size: 0.9rem;
}

/* Command Palette Overlay */
.command-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  justify-content: center;
  padding-top: 15vh;
}

.command-box {
  width: 580px;
  background: var(--bg-surface);
  border: 1px solid var(--border-focus);
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.8);
  border-radius: var(--radius-xl);
  overflow: hidden;
  height: fit-content;
}

.command-header {
  display: flex;
  align-items: center;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  gap: 0.75rem;
}

.cmd-prompt {
  font-family: var(--font-mono);
  color: var(--accent);
  font-weight: 700;
}

.command-header input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-main);
  font-size: 1rem;
}

.cmd-kbd {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-dim);
  background: var(--bg-deep);
  padding: 2px 6px;
  border-radius: 4px;
}

.command-results {
  max-height: 320px;
  overflow-y: auto;
  padding: 0.5rem;
}

.cmd-item {
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
}

.cmd-item:hover {
  background: rgba(0, 242, 254, 0.1);
  color: var(--accent);
}

/* Ideas & Links Grid */
.ideas-masonry {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}

.idea-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.idea-category {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--accent-purple);
  text-transform: uppercase;
}

.links-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1rem;
}

.link-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  text-decoration: none;
  color: var(--text-main);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s;
}

.link-card:hover {
  border-color: var(--accent);
  background: var(--bg-card-hover);
  transform: translateY(-2px);
}
